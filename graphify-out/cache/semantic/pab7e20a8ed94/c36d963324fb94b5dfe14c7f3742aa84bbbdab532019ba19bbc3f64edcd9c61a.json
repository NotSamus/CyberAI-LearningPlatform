{"nodes": [{"id": "readme", "label": "cyberAI-Platform README", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_fastapi_backend", "label": "FastAPI + uvicorn backend (api/)", "file_type": "concept", "source_file": "README.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_nextjs_frontend", "label": "Next.js + TypeScript frontend", "file_type": "concept", "source_file": "README.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_jupyterhub", "label": "JupyterHub per-student notebook environments", "file_type": "concept", "source_file": "README.md", "source_location": "L4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_student_jupyter_platform_architecture_doc", "label": "Student Jupyter Platform: Architecture & Setup (doc)", "file_type": "document", "source_file": "README.md", "source_location": "L6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_grading_service", "label": "Grading service (grader/)", "file_type": "concept", "source_file": "README.md", "source_location": "L494-497", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Student code never runs in the backend: each job gets a new no-network container of the notebook image (2 GB, one CPU, process limit, 5 minutes); only service besides the hub with the Docker socket, and it has no database access."}, {"id": "readme_otter_grader", "label": "Otter-Grader", "file_type": "concept", "source_file": "README.md", "source_location": "L463", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_postgres_database", "label": "Postgres 16 database", "file_type": "concept", "source_file": "README.md", "source_location": "L60-62", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dev uses the same Postgres 16 as production, on port 5433 so it does not clash with a Postgres installed on the Mac."}, {"id": "readme_alembic_migrations", "label": "Alembic database migrations (sql/)", "file_type": "concept", "source_file": "README.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_dev_sh", "label": "dev.sh (start everything locally)", "file_type": "concept", "source_file": "README.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_dev_hub_sh", "label": "dev-hub.sh (local JupyterHub in Docker)", "file_type": "concept", "source_file": "README.md", "source_location": "L36", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_dev_tunnel_sh", "label": "dev-tunnel.sh (SSH tunnel to a server)", "file_type": "concept", "source_file": "README.md", "source_location": "L79-91", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For a server whose firewall lets only SSH through: runs ./dev.sh --lan there and forwards ports 3000 and 8081 from your computer."}, {"id": "readme_lan_mode", "label": "LAN mode (dev.sh --lan)", "file_type": "concept", "source_file": "README.md", "source_location": "L67-107", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only for trying the site with trusted people: plain http, site and notebooks share one address so a notebook server receives the platform login; dev.sh makes new random secrets every start."}, {"id": "readme_environment_variables", "label": "Settings (environment variables, deploy/.env)", "file_type": "concept", "source_file": "README.md", "source_location": "L109-212", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_secret_validation", "label": "Secret strength check at backend start", "file_type": "rationale", "source_file": "README.md", "source_location": "L133", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backend refuses secrets shorter than 32 characters or containing 'dev-' or 'change-me', so development defaults never reach a server."}, {"id": "readme_accounts", "label": "Accounts (no public sign-up)", "file_type": "concept", "source_file": "README.md", "source_location": "L214-273", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_manage_cli", "label": "app.manage command line tool", "file_type": "concept", "source_file": "README.md", "source_location": "L216-269", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_admin_accounts", "label": "Admin > Accounts management", "file_type": "concept", "source_file": "README.md", "source_location": "L223-252", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Changing another admin's password or admin rights asks for your own password again, so a browser left logged in cannot lock out the other admins."}, {"id": "readme_username_generator", "label": "Gamertag-style username suggestions (api/app/usernames.py)", "file_type": "concept", "source_file": "README.md", "source_location": "L227-232", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Students have no names, only usernames; generated server-side from word lists checked so no pairing spells anything rude."}, {"id": "readme_roles", "label": "Roles: student, teacher, admin flag", "file_type": "concept", "source_file": "README.md", "source_location": "L265-273", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Platform admins are JupyterHub admins but teachers are not, because JupyterHub's admin role opens every notebook server."}, {"id": "readme_argon2_hashing", "label": "Argon2 password hashing", "file_type": "concept", "source_file": "README.md", "source_location": "L267", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_session_cookie", "label": "Server-side role checks with a script-unreadable session cookie", "file_type": "rationale", "source_file": "README.md", "source_location": "L271-273", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The browser stores nothing about role or password; admin/teacher is decided on the server for every request."}, {"id": "readme_home_page", "label": "Home page and Up next", "file_type": "concept", "source_file": "README.md", "source_location": "L282, L346-353", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_teach_area", "label": "Teach area (/teach)", "file_type": "concept", "source_file": "README.md", "source_location": "L283-292", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_admin_area", "label": "Admin area (/admin)", "file_type": "concept", "source_file": "README.md", "source_location": "L284", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_lessons", "label": "Lessons", "file_type": "concept", "source_file": "README.md", "source_location": "L296-371", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_lesson_blocks", "label": "Lesson blocks (text, code, callout, picture, video, notebook, questions)", "file_type": "concept", "source_file": "README.md", "source_location": "L299-310", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_lesson_text_import", "label": "Write or paste a whole lesson as text", "file_type": "concept", "source_file": "README.md", "source_location": "L327-330", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_lesson_publishing", "label": "Lesson working copy and Publish", "file_type": "concept", "source_file": "README.md", "source_location": "L332-338", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Students keep the published version while the teacher edits; publishing is refused while a question is unfinished."}, {"id": "readme_knowledge_checks", "label": "Server-checked knowledge checks", "file_type": "rationale", "source_file": "README.md", "source_location": "L362-371", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The student's browser never receives correct options, accepted answers or explanations; three tries; practice only, not graded."}, {"id": "readme_code_highlighting", "label": "Code syntax highlighting (highlight.js via lowlight/rehype-highlight)", "file_type": "concept", "source_file": "README.md", "source_location": "L312-317", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns a tree React draws, never HTML; unknown languages are shown as-is, never guessed."}, {"id": "readme_lesson_zip_format", "label": "Lesson .zip export/import (format version 1)", "file_type": "concept", "source_file": "README.md", "source_location": "L373-408", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The .zip carries solutions, hidden tests and check answers, so it must be kept from students; import is all-or-nothing and lands as drafts."}, {"id": "readme_assignments", "label": "Assignments", "file_type": "concept", "source_file": "README.md", "source_location": "L410-427", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_data_files", "label": "Assignment data files (datasets)", "file_type": "concept", "source_file": "README.md", "source_location": "L429-448", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each student gets an own copy that is never overwritten; added to Otter's files: list because grading has no network; stored in Postgres (assignment_files) so backups cover them."}, {"id": "readme_submissions", "label": "Submitting and grading", "file_type": "concept", "source_file": "README.md", "source_location": "L454-472", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_autograded_vs_hand_graded", "label": "Autograded vs hand-graded assignments", "file_type": "concept", "source_file": "README.md", "source_location": "L461-472", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_assignment_notebook_editing", "label": "Edit in JupyterLab / Replace notebook (before first open)", "file_type": "concept", "source_file": "README.md", "source_location": "L474-481", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The notebook is frozen once a student opens it: their copy is theirs and would no longer match the tests."}, {"id": "readme_gradebook", "label": "Gradebook", "file_type": "concept", "source_file": "README.md", "source_location": "L483-492", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read opened submissions, do not run them: the teacher's environment has network access and hidden tests in reach."}, {"id": "readme_courses", "label": "Courses and announcements", "file_type": "concept", "source_file": "README.md", "source_location": "L499-508", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_progress_export", "label": "Students' progress and grades export (CSV / Excel)", "file_type": "concept", "source_file": "README.md", "source_location": "L510-537", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_csv_formula_injection_guard", "label": "CSV formula-injection guard", "file_type": "rationale", "source_file": "README.md", "source_location": "L535-537", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cells starting with =, +, -, @, tab or CR get a leading ' so a spreadsheet never runs them as formulas."}, {"id": "readme_security_checks", "label": "Upload security checks", "file_type": "concept", "source_file": "README.md", "source_location": "L553-572", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_request_size_limits", "label": "Request size limits (LimitRequestSize)", "file_type": "rationale", "source_file": "README.md", "source_location": "L556-559", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_zip_bomb_protection", "label": "Lesson .zip zip-bomb protection", "file_type": "rationale", "source_file": "README.md", "source_location": "L562-565", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never unpacked to disk; only files named in lessons.json are read, each with its own limit and 300 MB in all."}, {"id": "readme_picture_validation", "label": "Picture validation by file signature (no SVG)", "file_type": "rationale", "source_file": "README.md", "source_location": "L568-570", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accepted by how the file starts, never by its name; SVG refused because it can carry scripts."}, {"id": "readme_login_rate_limit", "label": "Login rate limit (MAX_LOGIN_ATTEMPTS)", "file_type": "rationale", "source_file": "README.md", "source_location": "L574-575", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_security_tests", "label": "Security test suite (test_security.py and teacher-API tests)", "file_type": "concept", "source_file": "README.md", "source_
d."}, {"id": "deploy_readme_login_lockout", "label": "Password-guessing lockout behind Caddy (in-memory, one uvicorn worker)", "file_type": "concept", "source_file": "deploy/README.md", "source_location": "L167-180", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counters live in backend memory; backend trusts X-Forwarded-For, so it must be reachable only through Caddy."}, {"id": "deploy_readme_trusted_proxies", "label": "Caddy trusted_proxies (university proxy)", "file_type": "concept", "source_file": "deploy/README.md", "source_location": "L174-177", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_readme_scoped_hub_tokens", "label": "Per-operation hub tokens (two minutes, one server)", "file_type": "rationale", "source_file": "deploy/README.md", "source_location": "L188-197", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_readme_platform_role", "label": "platform-role hub permissions", "file_type": "concept", "source_file": "deploy/README.md", "source_location": "L193-196", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Can create users, start servers and mint tokens for any user, so it reaches every home in the end: keep it only in deploy/.env."}, {"id": "deploy_readme_admin_audit_log", "label": "Admin action log (docker compose logs backend)", "file_type": "concept", "source_file": "deploy/README.md", "source_location": "L199-201", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_readme_lesson_zip_transfer", "label": "Moving lessons between platforms via .zip", "file_type": "concept", "source_file": "deploy/README.md", "source_location": "L49-55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No database copy or migration needed; a university proxy must allow 101 MB to /api/teach/lesson-import